# Copy to .env and adjust. Every variable is optional; defaults shown.

# Interface and port for `specsentry serve` (use 0.0.0.0 in containers).
BIND_ADDR=127.0.0.1
PORT=3005

# SQLite file; its directory is created on boot.
DATABASE_PATH=data/specsentry.sqlite

# Directory containing the web UI (index.html).
PUBLIC_DIR=public

# Request limits.
MAX_BODY_BYTES=2097152
REQUEST_TIMEOUT_SECS=15

# Logging: json (production) or pretty (local). Filter with RUST_LOG.
LOG_FORMAT=json
RUST_LOG=info

# Seed a fictional demo project when the database is empty.
SEED_DEMO=true
